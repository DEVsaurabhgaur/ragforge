# ─── RAGForge Configuration ────────────────────────────────
# Copy this to .env and fill your keys. Never commit .env!

# LLM Provider: 'gemini' (free) or 'openai'
LLM_PROVIDER=gemini

# Embedding Provider: 'local' (free HuggingFace) or 'openai'
EMBEDDING_PROVIDER=local

# ── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ── Google Gemini ──────────────────────────────────────────
# Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# ── Free Setup (no credit card needed) ─────────────────────
# LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER=local
# GEMINI_API_KEY=your-key
